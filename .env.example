# Alpha Vantage API key for the Providers page. Claim a free one at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Marketstack API key for the Providers page. Claim a free one at https://marketstack.com/signup/free
MARKETSTACK_API_KEY=
# Alpaca Market Data key ID and secret for the Providers page. Both are needed. Create them at https://app.alpaca.markets/signup (a free paper account works)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Alpaca trading (the /api/trading routes). Paper is the default and uses the market-data pair above unless you set these.
# Paper keys come from the paper account in the Alpaca dashboard and only work on the paper host.
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=
# Live trading places REAL orders with REAL money. It is off unless ALPACA_ENABLE_LIVE_TRADING=true, and uses only these keys.
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_API_SECRET_KEY=
ALPACA_ENABLE_LIVE_TRADING=
# Extra Host names the trading routes may be reached by (comma separated). localhost, 127.0.0.1 and ::1 always work.
TVDATA_TRADING_ALLOWED_HOSTS=
# Computers (addresses or ranges, comma separated) that may use the trading routes besides this one, for example a Docker bridge 172.17.0.0/16. Loopback always works. Only list addresses you control: the server has no login.
TVDATA_TRADING_ALLOWED_CLIENTS=
# Requests that carry X-Forwarded-For, Forwarded or X-Real-IP (they came through a proxy) are refused, because a proxy can pass on a caller's forged claim to be local.
# Set true ONLY for a reverse proxy of your own that overwrites X-Forwarded-For with the address it saw (not appends) and drops the other two.
TVDATA_TRADING_TRUST_PROXY=
